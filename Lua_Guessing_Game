--A guessing game were the user guess a number between 1 and 100 and has 7 attempts to get the right number,
--while being told higher or lower to help them guess the right number.


-- use ( lua54 Lua_Guessing_Game ) to run the program.

GameNumber = 1
GameFinished = 0
UserInput = "U"

while GameFinished ~= 1 do

    UserInput = "U"

    
    math.randomseed(os.time())
    RandomNumber = math.random(1, 100) 

    print("Guess A number between 1 and 100")

    Attempts = 7

    while Attempts >= 0 or Attempts ~= -9 do


        print(" ")
        print("Attempts Remaining: " .. Attempts)
        io.write("Guess Number: ")
        UserNumberGuess = tonumber(io.read())


            while UserNumberGuess == nil do
                print ("That isn't a number.")

                print(" ")
                io.write("Guess Number: ")
                UserNumberGuess = tonumber(io.read())
            end

            if (UserNumberGuess < RandomNumber) then
                print("Guessed Number is too Low.")
                Attempts = Attempts - 1

            else if (UserNumberGuess > RandomNumber) then
                print("Guessed Number is too High.")
                Attempts = Attempts - 1

            else   
                print("You Win, Your Number was: " .. RandomNumber .. ".")
                Attempts = -9
            end

        end

        if Attempts == -1 then
            print("You Lose, Your Number was: " .. RandomNumber .. ".")

        end

    end

    while UserInput == "U" do

        print(" ")
        print("Do you want to Continue Playing? Y/N.")
        io.write("Input: ")
        UserInput = io.read()
        UpperUserInput = string.upper(UserInput)

            if UpperUserInput == ("Y") then
                GameFinished = 0

            else if UpperUserInput == ("N") then
                GameFinished = 1


            else
                print("Invalid Input. Enter Y/N to make selection.")
                UserInput = ("U")

            end
        end
    end

end

print("Program Closing.")